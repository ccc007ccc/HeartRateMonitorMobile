<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.settings.SettingsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/settings_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextAppearance.App.SettingSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_general" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/historyRecordingSwitch"
                        style="@style/SettingsRow"
                        android:layout_marginBottom="12dp"
                        android:padding="0dp"
                        android:text="@string/settings_record_history" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/heartbeatAnimationSwitch"
                        style="@style/SettingsRow"
                        android:layout_marginBottom="12dp"
                        android:padding="0dp"
                        android:text="@string/settings_heartbeat_animation" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/monetColorSwitch"
                            style="@style/SettingsRow"
                            android:padding="0dp"
                            android:text="@string/settings_dynamic_color" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="4dp"
                            android:text="@string/settings_dynamic_color_hint"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/speedDisplaySwitch"
                            style="@style/SettingsRow"
                            android:padding="0dp"
                            android:text="@string/settings_show_speed" />

                        <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:text="@string/settings_show_speed_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/hideFromRecentsSwitch"
                    style="@style/SettingsRow"
                    android:layout_marginTop="12dp"
                    android:padding="0dp"
                    android:text="@string/settings_hide_recents" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/settings_hide_recents_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:id="@+id/favoriteDevicesLink"
                        style="@style/SettingsRow"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="0dp"
                        android:text="@string/favorite_title"
                        app:drawableEndCompat="@drawable/ic_arrow_forward"
                        app:drawableTint="?attr/colorOnSurfaceVariant" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:id="@+id/heartRateAlarmLink"
                        style="@style/SettingsRow"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="0dp"
                        android:text="@string/alarm_title"
                        app:drawableEndCompat="@drawable/ic_arrow_forward"
                        app:drawableTint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.App.SettingSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_bluetooth" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/autoConnectSwitch"
                        style="@style/SettingsRow"
                        android:layout_marginBottom="12dp"
                        android:padding="0dp"
                        android:text="@string/settings_auto_connect" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/autoReconnectSwitch"
                        style="@style/SettingsRow"
                        android:padding="0dp"
                        android:text="@string/settings_auto_reconnect" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.App.SettingSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_integrations" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="0dp">

                    <TextView
                        android:id="@+id/serverSettingsLink"
                        style="@style/SettingsRow"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp"
                        android:text="@string/settings_http_ws_server"
                        app:drawableEndCompat="@drawable/ic_arrow_forward"
                        app:drawableTint="?attr/colorOnSurfaceVariant" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:id="@+id/webhookSettingsLink"
                        style="@style/SettingsRow"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp"
                        android:text="@string/webhook_settings"
                        app:drawableEndCompat="@drawable/ic_arrow_forward"
                        app:drawableTint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.App.SettingSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_statusbar" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/statusBarResidentSwitch"
                        style="@style/SettingsRow"
                        android:layout_marginBottom="12dp"
                        android:padding="0dp"
                        android:text="@string/statusbar_resident" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:text="@string/statusbar_resident_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- 常驻开关关闭时整块隐藏（由 SettingsActivity 按设置流控制） -->
                    <LinearLayout
                        android:id="@+id/statusBarOptionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/statusBarBpmTextSwitch"
                        style="@style/SettingsRow"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:padding="0dp"
                        android:text="@string/statusbar_show_bpm_unit" />

                    <TextView
                        style="@style/SettingsSubLabel"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/statusbar_horizontal_position" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/statusBarXPositionSeekBar"
                        style="@style/SettingsSeekBar"
                        android:layout_marginBottom="12dp"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <TextView
                        style="@style/SettingsSubLabel"
                        android:layout_marginBottom="4dp"
                        android:text="@string/statusbar_vertical_offset" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/statusBarYOffsetSeekBar"
                        style="@style/SettingsSeekBar"
                        android:layout_marginBottom="12dp"
                        android:valueFrom="0"
                        android:valueTo="20"
                        android:stepSize="1" />

                    <TextView
                        style="@style/SettingsSubLabel"
                        android:layout_marginBottom="4dp"
                        android:text="@string/statusbar_overall_size" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/statusBarSizeSeekBar"
                        style="@style/SettingsSeekBar"
                        android:layout_marginBottom="12dp"
                        android:valueFrom="0"
                        android:valueTo="200"
                        android:stepSize="1" />

                    <TextView
                        style="@style/SettingsSubLabel"
                        android:layout_marginBottom="4dp"
                        android:text="@string/statusbar_text_weight" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/statusBarTextThicknessSeekBar"
                        style="@style/SettingsSeekBar"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <TextView
                        style="@style/SettingsSubLabel"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/statusbar_text_color" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/statusBarAutoColorSwitch"
                        style="@style/SettingsRow"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:padding="0dp"
                        android:text="@string/statusbar_auto_color" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:text="@string/statusbar_auto_color_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/statusBarWhiteTextSwitch"
                        style="@style/SettingsRow"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:padding="0dp"
                        android:text="@string/statusbar_white_text" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:text="@string/statusbar_white_text_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/floatingSectionTitle"
                style="@style/TextAppearance.App.SettingSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_floating" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/floatingSectionCard"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/floating_pass_through_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/bpmTextSwitch"
                        style="@style/SettingsRow"
                        android:layout_marginBottom="12dp"
                        android:padding="0dp"
                        android:text="@string/floating_show_bpm_text" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/heartIconSwitch"
                        style="@style/SettingsRow"
                        android:layout_marginBottom="16dp"
                        android:padding="0dp"
                        android:text="@string/floating_show_heart_icon" />

                    <TextView
                        style="@style/SettingsSubLabel"
                        android:layout_marginBottom="4dp"
                        android:text="@string/floating_overall_size" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sizeSeekBar"
                        style="@style/SettingsSeekBar"
                        android:layout_marginBottom="12dp"
                        android:valueFrom="0"
                        android:valueTo="200"
                        android:stepSize="1" />

                    <TextView
                        style="@style/SettingsSubLabel"
                        android:layout_marginBottom="4dp"
                        android:text="@string/floating_icon_size" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/iconSizeSeekBar"
                        style="@style/SettingsSeekBar"
                        android:layout_marginBottom="12dp"
                        android:valueFrom="0"
                        android:valueTo="200"
                        android:stepSize="1" />

                    <TextView
                        style="@style/SettingsSubLabel"
                        android:layout_marginBottom="4dp"
                        android:text="@string/floating_corner_radius" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/cornerRadiusSeekBar"
                        style="@style/SettingsSeekBar"
                        android:layout_marginBottom="12dp"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <TextView
                        style="@style/SettingsSubLabel"
                        android:layout_marginBottom="4dp"
                        android:text="@string/floating_bg_opacity" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/bgAlphaSeekBar"
                        style="@style/SettingsSeekBar"
                        android:layout_marginBottom="12dp"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <TextView
                        style="@style/SettingsSubLabel"
                        android:layout_marginBottom="4dp"
                        android:text="@string/floating_border_opacity" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/borderAlphaSeekBar"
                        style="@style/SettingsSeekBar"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/textColorPreview"
                                style="@style/ColorPreview"
                                android:background="@android:color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/floating_label_text"
                                android:textAppearance="?attr/textAppearanceBodySmall" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/bgColorPreview"
                                style="@style/ColorPreview"
                                android:background="@android:color/black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/floating_label_bg"
                                android:textAppearance="?attr/textAppearanceBodySmall" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:id="@+id/borderColorPreview"
                                style="@style/ColorPreview"
                                android:background="@android:color/darker_gray" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/floating_label_border"
                                android:textAppearance="?attr/textAppearanceBodySmall" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.App.SettingSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_section_about" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_version"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <TextView
                            android:id="@+id/appVersionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="1.0.0"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:id="@+id/githubLink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="16dp"
                        android:text="@string/settings_visit_github"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        app:drawableEndCompat="@drawable/ic_github"
                        app:drawableTint="?attr/colorPrimary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>