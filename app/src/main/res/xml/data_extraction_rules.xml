<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ 的备份/迁移规则。与 backup_rules.xml 同口径：
   健康敏感数据（心率历史）与凭据（Webhook 配置、服务器 token）不进云备份、不随设备迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="heart_rate_database" />
        <exclude domain="database" path="heart_rate_database-wal" />
        <exclude domain="database" path="heart_rate_database-shm" />
        <exclude domain="file" path="config_webhook.json" />
        <exclude domain="file" path="datastore/app_settings.preferences_pb" />
        <exclude domain="sharedpref" path="app_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="heart_rate_database" />
        <exclude domain="database" path="heart_rate_database-wal" />
        <exclude domain="database" path="heart_rate_database-shm" />
        <exclude domain="file" path="config_webhook.json" />
        <exclude domain="file" path="datastore/app_settings.preferences_pb" />
        <exclude domain="sharedpref" path="app_settings.xml" />
    </device-transfer>
</data-extraction-rules>
